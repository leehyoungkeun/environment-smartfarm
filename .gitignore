# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local
.env.development
# .env.production은 git에 포함 (프로덕션 API URL은 브라우저에서 노출되므로 민감정보 아님)

# Build output
dist/
dist-*/
build/

# Uploads (user-generated content)
uploads/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Logs
*.log
logs/

# Backup files
*.backup
*.bak

# Prisma
backend/prisma/*.db
backend/prisma/migrations/

# Node-RED
node-red/.config*.json
node-red/flows_cred.json

# Frontend cache
frontend/.vite/
frontend/node_modules/.cache/

# Debug/maintenance scripts (may contain credentials)
backend/scripts/

# Claude Code
.claude/

# Screenshots (디버그용은 ignore, 매뉴얼용은 예외)
*.PNG
*.png
!docs/screenshots/**/*.png
!docs/screenshots/**/*.PNG
!docs/screen/**/*.png
!docs/screen/**/*.PNG
!frontend/public/**/*.png

# Root lock file (monorepo 아님)
/package-lock.json

# Temp/fix files
*.txt.bak
backend/fix-*.txt

# Misc
*.tgz
*.tar.gz
*.zip
backend/certs/

# RPi 농장 백업 (AWS IoT 인증서 포함 — git에 절대 올리지 말 것)
rpi-files/farm_*-backup-*/
rpi-files/master/*.bak.*
download/
# 알림 채널 웹훅 URL — 그 자체가 인증 수단이므로 커밋 금지
monitoring/discord_webhook_url
monitoring/*_url
monitoring/*.bak-*
