# ====================================
# RPi 서버 환경변수 (마스터 placeholder)
# ====================================
# setup.js 가 첫 부팅 후 장비 코드 입력 시 sed 로 치환:
# - AWS_IOT_CLIENT_ID, MQTT_TOPIC_PREFIX 의 'UNSET' → 'farm_XXXX'

# 서버 설정
PORT=3001

# SQLite 데이터베이스
DB_PATH=./data/smartfarm.db

# JWT 인증 (로컬)
JWT_SECRET=lhk

# AWS IoT Core
AWS_IOT_ENDPOINT=a2ybxz5mrpnfww-ats.iot.ap-northeast-2.amazonaws.com
AWS_IOT_CERT_PATH=/home/lhk/certs/certificate.pem.crt
AWS_IOT_KEY_PATH=/home/lhk/certs/private.pem.key
AWS_IOT_CA_PATH=/home/lhk/certs/AmazonRootCA1.pem
AWS_IOT_CLIENT_ID=MyFarmPi_UNSET
MQTT_TOPIC_PREFIX=farm/MyFarmPi_UNSET
