    "description": "farms.status='active' 인 농장만 나온다. 운영 중지 농장은 상태만 바꾸면 자동으로 빠진다.\n'임계 이탈' 은 설정된 경보 상·하한을 벗어난 센서 개수다.",
    "datasource": {
     "type": "prometheus",
     "uid": "bflmwho4bsnb4c"
    },
    "gridPos": {
     "x": 0,
     "y": 0,
     "w": 24,
     "h": 12
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bflmwho4bsnb4c"
      },
      "editorMode": "code",
      "expr": "max by (farm_id) (smartfarm_sensor_last_seen_seconds)",
      "format": "table",
      "instant": true,
      "legendFormat": "",
      "range": false,
      "refId": "A"
     },
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bflmwho4bsnb4c"
      },
      "editorMode": "code",
      "expr": "sum by (farm_id) ((smartfarm_sensor_value > bool on(farm_id,house_id,sensor_id) smartfarm_sensor_threshold_max) + (smartfarm_sensor_value < bool on(farm_id,house_id,sensor_id) smartfarm_sensor_threshold_min))",
      "format": "table",
      "instant": true,
      "legendFormat": "",
      "range": false,
      "refId": "B"
     },
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bflmwho4bsnb4c"
      },
      "editorMode": "code",
      "expr": "max by (farm_id) (smartfarm_sensor_value{sensor_id=~\"temp.*\"})",
      "format": "table",
      "instant": true,
      "legendFormat": "",
      "range": false,
      "refId": "C"
     },
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bflmwho4bsnb4c"
      },
      "editorMode": "code",
      "expr": "max by (farm_id) (smartfarm_sensor_value{sensor_id=~\"humi.*\"})",
