# RPi 로 scp 되는 파일은 Windows 작업본도 LF 여야 한다.
#   CRLF 면 bash: $'\r': command not found,
#   systemd 는 값 끝에 \r 이 붙어 "Unknown key" 또는 엉뚱한 경로,
#   udev 는 SYMLINK 이름에 \r 이 섞여 /dev/smartfarm-485 가 안 생긴다.
# 저장소에는 LF 로 들어 있어도, 보호가 없으면 **새로 clone 할 때 CRLF 로 풀린다** (2026-10-07).
*.sh       text eol=lf
*.py       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf

# 제어기에 설치되는 설정 파일들 (2026-10-07 추가 — 자가복구 유닛을 넣으며 빠진 것을 발견)
*.rules    text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.conf     text eol=lf
*.desktop  text eol=lf

# 확장자가 없는 것들 — 경로로 지정
rpi-files/master/authorized_keys        text eol=lf
rpi-files/master/etc/sudoers-smartfarm-d16  text eol=lf
