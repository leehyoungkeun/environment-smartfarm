const PhaseTimeline = ({ phaseInfo, dimmed }) => {
  const cur = phaseInfo ? PHASE_PLAN.findIndex(p => p.key === phaseInfo.phaseKey) : -1;
  return (
    <section style={{
      marginTop: 16, padding: '16px 18px',
      background: T.card, border: `1px solid ${T.bd}`, borderRadius: 10,
      opacity: dimmed ? 0.45 : 1, transition: 'opacity 0.25s',
    }}>
      <div style={{
        display: 'flex', justifyContent: 'space-between', alignItems: 'baseline',
        marginBottom: 14,
      }}>
        <div style={kicker}>사이클 진행</div>
        <div style={{ fontSize: 11, color: T.fg3, fontFamily: MONO }}>
          {phaseInfo
            ? `${String(cur + 1).padStart(2, '0')} / ${String(PHASE_PLAN.length).padStart(2, '0')} 단계`
            : '사이클 대기'}
        </div>
      </div>

      <div style={{ display: 'flex', alignItems: 'flex-start', gap: 4 }}>
        {PHASE_PLAN.map((p, i) => {
          const past = cur > i;
          const isCur = cur === i;
          const c = isCur ? T.acc : past ? T.ok : T.fg4;
          return (
            <React.Fragment key={p.key}>
              <div style={{ flex: 1, position: 'relative', minWidth: 0 }}>
                {/* node */}
                <div style={{
                  display: 'flex', alignItems: 'center', gap: 8,
                }}>
                  <div style={{
                    width: 22, height: 22, borderRadius: 11,
                    border: `1.5px solid ${c}`,
                    background: isCur ? T.accBg : past ? '#f0fdf4' : T.card,
                    display: 'flex', alignItems: 'center', justifyContent: 'center',
                    fontFamily: MONO, fontSize: 10, fontWeight: 700, color: c,
                    flexShrink: 0,
                    animation: isCur ? 'sd-pulse 2s infinite' : 'none',
                  }}>
                    {past ? '✓' : String(i + 1).padStart(2, '0')}
                  </div>
                  <div style={{
                    fontSize: 11, fontWeight: 700, color: isCur ? T.fg : past ? T.ok : T.fg3,
                    letterSpacing: '0.04em',
                  }}>
                    {p.short}
                  </div>
                </div>
                {/* meta */}
                <div style={{
                  marginTop: 6, marginLeft: 32,
                  fontSize: 10.5, color: isCur ? T.fg2 : T.fg3, fontFamily: MONO,
                }}>
                  {isCur && phaseInfo
                    ? <>{fmtMS(phaseInfo.elapsed)} · −{fmtMS(phaseInfo.remaining)}</>
                    : past ? <>완료 · {p.duration}s</> : <>대기 · {p.duration}s</>}
                </div>
                {/* progress bar — current only */}
                {isCur && phaseInfo && (
                  <div style={{
                    marginTop: 6, marginLeft: 32, marginRight: 10,
                    height: 2, background: T.hair, borderRadius: 1, overflow: 'hidden',
                  }}>
                    <div style={{
                      width: `${phaseInfo.progress * 100}%`, height: '100%',
                      background: T.acc, transition: 'width 0.4s',
                    }} />
                  </div>
                )}
              </div>
              {/* connector line between nodes */}
              {i < PHASE_PLAN.length - 1 && (
                <div style={{
                  flexShrink: 0, width: 16, height: 1.5, marginTop: 10,
                  background: cur > i ? T.ok : T.hair,
                }}/>
              )}
            </React.Fragment>
          );
        })}
      </div>
    </section>
  );
};

