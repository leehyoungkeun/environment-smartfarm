generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model alert {
  id             String    @default(dbgenerated("(gen_random_uuid())::text"))
  timestamp      DateTime  @default(now()) @db.Timestamptz(6)
  farmId         String    @map("farm_id")
  houseId        String    @map("house_id")
  sensorId       String?   @map("sensor_id")
  alertType      String    @map("alert_type")
  severity       String?   @default("WARNING")
  message        String?
  value          Float?
  threshold      Float?
  metadata       Json?     @default("{}")
  acknowledged   Boolean?  @default(false)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)

  @@id([timestamp, id])
  @@index([timestamp(sort: Desc)])
  @@index([farmId, houseId, timestamp(sort: Desc)], map: "idx_alerts_farm_house")
  @@map("alerts")
}

model auditLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId     String?  @map("farm_id")
  userId     String?  @map("user_id")
  userName   String?  @map("user_name")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([farmId, createdAt(sort: Desc)], map: "idx_audit_logs_farm")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_time")
  @@map("audit_logs")
}

model automationRule {
  id              String    @id
  farmId          String    @map("farm_id")
  houseId         String?   @map("house_id")
  name            String
  description     String    @default("")
  enabled         Boolean   @default(true)
  conditionLogic  String    @default("AND") @map("condition_logic")
  conditions      Json
  actions         Json
  cooldownSeconds Int       @default(300) @map("cooldown_seconds")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  triggerCount    Int       @default(0) @map("trigger_count")
  priority        Int       @default(10)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  groupLogic      String    @default("AND") @map("group_logic")

  @@index([farmId, houseId, enabled])
  @@map("automation_rules")
}

model businessProject {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  farms     farm[]

  @@map("business_projects")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model controlLog {
  id               String   @default(dbgenerated("(gen_random_uuid())::text"))
  timestamp        DateTime @default(now()) @db.Timestamptz(6)
  farmId           String   @map("farm_id")
  houseId          String   @map("house_id")
  controlHouseId   String?  @map("control_house_id")
  deviceId         String   @map("device_id")
  deviceType       String?  @default("unknown") @map("device_type")
  deviceName       String?  @map("device_name")
  command          String
  success          Boolean  @default(true)
  error            String?
  requestId        String?  @map("request_id")
  operator         String?  @default("web_dashboard")
  operatorName     String?  @map("operator_name")
  lambdaResponse   Json?    @map("lambda_response")
  isAutomatic      Boolean? @default(false) @map("is_automatic")
  automationRuleId String?  @map("automation_rule_id")
  automationReason String?  @map("automation_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([timestamp, id])
  @@index([timestamp(sort: Desc)])
  @@index([farmId, deviceId, timestamp(sort: Desc)], map: "idx_control_logs_farm_device")
  @@index([farmId, houseId, timestamp(sort: Desc)], map: "idx_control_logs_farm_house")
  @@index([requestId], map: "idx_control_logs_request_id")
  @@map("control_logs")
}

model farmDocument {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId       String   @map("farm_id")
  fileName     String   @map("file_name")
  originalName String   @map("original_name")
  filePath     String   @map("file_path")
  fileSize     Int      @default(0) @map("file_size")
  mimeType     String?  @map("mime_type")
  category     String   @default("other")
  description  String?
  uploadedBy   String?  @map("uploaded_by")
  uploaderId   String?  @map("uploader_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  farm         farm     @relation(fields: [farmId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([farmId, createdAt(sort: Desc)], map: "idx_farm_documents_created")
  @@index([farmId, category], map: "idx_farm_documents_farm")
  @@map("farm_documents")
}

model farmJournal {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId       String   @map("farm_id")
  houseId      String?  @map("house_id")
  date         DateTime @db.Date
  weather      String?
  tempMin      Float?   @map("temp_min")
  tempMax      Float?   @map("temp_max")
  humidity     Float?
  workType     String   @map("work_type")
  growthStage  String?  @map("growth_stage")
  // 작목·품종·작기 (시설별 현재 작물 추적, 인증/규제 + 일관성)
  cropName     String?  @map("crop_name") // 활성 작기에서 자동 채움 (작성 시 snapshot)
  variety      String? // 품종
  cropCycleId  String?  @map("crop_cycle_id") // FK to cropCycle (선택, 자동 매핑)
  content      String
  pest         String?
  notes        String?
  tags         String[] @default([])
  // 생육 측정 (P1-A) — 선택 입력. 매주 1회 정도 농민이 측정한 수치.
  // { plantHeight, leafCount, floweringRate, fruitSetRate, custom: [{name, value, unit}] }
  measurements Json?    @default("{}")
  // GPS 위치 (P3-B) — 모바일에서 자동 캡처
  gpsLat       Float?   @map("gps_lat")
  gpsLng       Float?   @map("gps_lng")
  gpsAccuracy  Float?   @map("gps_accuracy")
  photos       Json     @default("[]")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([farmId, date])
  @@index([farmId, houseId, date])
  @@index([cropCycleId])
  @@index([tags], type: Gin)
  @@map("farm_journals")
}

// 영농일지 템플릿 — 자주 쓰는 작업을 1 클릭으로 일지 생성
// payload 는 farmJournal 의 일부 필드 (workType, content, tags 등) 를 미리 저장한 JSON
model journalTemplate {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId    String   @map("farm_id")
  name      String
  emoji     String?
  payload   Json     @default("{}")
  useCount  Int      @default(0) @map("use_count")
  sortOrder Int      @default(0) @map("sort_order")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([farmId, sortOrder])
  @@map("journal_templates")
}

model farmNote {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId    String    @map("farm_id")
  content   String
  author    String?
  authorId  String?   @map("author_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  farm      farm      @relation(fields: [farmId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([farmId, createdAt(sort: Desc)], map: "idx_farm_notes_farm_created")
  @@map("farm_notes")
}

model farmSchedule {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId      String    @map("farm_id")
  title       String
  description String?
  type        String    @default("general")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  allDay      Boolean   @default(true) @map("all_day")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  assignedTo  String?   @map("assigned_to")
  houseId     String?   @map("house_id")
  priority    String    @default("normal")
  color       String?
  recurrence  Json?
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  farm        farm      @relation(fields: [farmId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([farmId, completed, startDate], map: "idx_farm_schedules_completed")
  @@index([farmId, startDate], map: "idx_farm_schedules_farm_date")
  @@map("farm_schedules")
}

model farm {
  id                 String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId             String           @unique @map("farm_id")
  name               String
  location           String?
  ownerName          String?          @map("owner_name")
  ownerPhone         String?          @map("owner_phone")
  apiKey             String           @unique @map("api_key")
  status             String?          @default("active")
  lastSeenAt         DateTime?        @map("last_seen_at") @db.Timestamptz(6)
  memo               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @map("updated_at")
  managers           Json?            @default("[]")
  registeredAt       DateTime?        @default(dbgenerated("CURRENT_DATE")) @map("registered_at") @db.Date
  maintenanceMonths  Int?             @default(12) @map("maintenance_months")
  maintenanceStartAt DateTime?        @default(dbgenerated("CURRENT_DATE")) @map("maintenance_start_at") @db.Date
  systemType         String?          @map("system_type")
  farmType           String?          @map("farm_type")
  farmArea           String?          @map("farm_area")
  tags               String[]         @default([])
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(6)
  businessProjectId  String?          @map("business_project_id")
  totalCost          BigInt?          @map("total_cost")
  subsidyAmount      BigInt?          @map("subsidy_amount")
  selfFunding        BigInt?          @map("self_funding")
  businessType       String?          @map("business_type")
  farmDocuments      farmDocument[]
  farmNotes          farmNote[]
  farmSchedules      farmSchedule[]
  businessProject    businessProject? @relation(fields: [businessProjectId], references: [id], onUpdate: NoAction)
  maintenanceLogs    maintenanceLog[]
  userFarms          userFarm[]
  devices            device[]

  @@map("farms")
}

model device {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  deviceCode      String    @unique @map("device_code")
  farmId          String?   @map("farm_id")
  status          String    @default("pending") // pending, online, offline, maintenance
  rpiSerial       String?   @map("rpi_serial")
  ipAddress       String?   @map("ip_address")
  mqttClientId    String?   @map("mqtt_client_id")
  firmwareVersion String?   @map("firmware_version")
  cpuUsage        Float?    @map("cpu_usage")
  memoryUsed      Float?    @map("memory_used")
  memoryTotal     Float?    @map("memory_total")
  diskUsage       Float?    @map("disk_usage")
  uptime          Float?
  installedAt     DateTime? @map("installed_at") @db.Timestamptz(6)
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(6)
  memo            String?
  certPem         String?   @map("cert_pem")
  privateKey      String?   @map("private_key")
  awsThingName    String?   @map("aws_thing_name")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  farm            farm?     @relation(fields: [farmId], references: [farmId], onDelete: SetNull, onUpdate: NoAction)

  @@index([farmId], map: "idx_devices_farm")
  @@index([status], map: "idx_devices_status")
  @@index([lastSeenAt], map: "idx_devices_last_seen")
  @@map("devices")
}

model harvestRecord {
  id             String   @id
  farmId         String   @map("farm_id")
  houseId        String?  @map("house_id")
  date           DateTime @db.Date
  cropName       String   @map("crop_name")
  variety        String? // 품종
  cropCycleId    String?  @map("crop_cycle_id") // 활성 작기 매핑
  tags           String[] @default([]) // 분류·검색용 태그
  quantity       Float
  unit           String   @default("kg")
  grade          String?
  destination    String?
  unitPrice      Float?   @map("unit_price")
  totalRevenue   Float?   @map("total_revenue")
  notes          String?
  // 출하 이력 (농산물이력제 의무, 단계 3)
  lotNumber      String?  @map("lot_number") // 로트번호 (자율 부여, 일자 + 작목 + 일련번호 권장)
  traceabilityNo String?  @map("traceability_no") // 농산물이력추적관리 등록번호 (12 자리)
  buyer          String? // 거래처/구매자 (출하 추적)
  invoiceNo      String?  @map("invoice_no") // 거래명세서 번호
  loss           Float? // 폐기/등외품 수량
  lossReason     String?  @map("loss_reason")
  qualityMetrics Json?    @default("{}") @map("quality_metrics") // {brix, acidity, size, color}
  photos         Json     @default("[]")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([farmId, date])
  @@index([lotNumber])
  @@map("harvest_records")
}

model houseConfig {
  id            String   @id
  farmId        String   @map("farm_id")
  houseId       String   @map("house_id")
  houseName     String   @default("") @map("house_name")
  sensors       Json     @default("[]")
  collection    Json     @default("{}")
  devices       Json     @default("[]")
  deviceCount   Int      @default(0) @map("device_count")
  enabled       Boolean  @default(true)
  configVersion Int      @default(1) @map("config_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  crops         Json     @default("[]")
  cropType      String   @default("") @map("crop_type")
  cropVariety   String   @default("") @map("crop_variety")
  plantingDate  String   @default("") @map("planting_date")

  @@unique([farmId, houseId])
  @@map("house_configs")
}

// 작기 (Crop Cycle) — 정식~수확 단위 추적 (GAP/친환경 의무: 작기별 기록)
model cropCycle {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId              String    @map("farm_id")
  houseId             String?   @map("house_id")
  cropName            String    @map("crop_name")
  variety             String? // 품종
  plantingDate        DateTime  @map("planting_date") @db.Date
  expectedHarvestDate DateTime? @map("expected_harvest_date") @db.Date
  actualEndDate       DateTime? @map("actual_end_date") @db.Date
  areaM2              Float?    @map("area_m2")
  plantCount          Int?      @map("plant_count")
  status              String    @default("active") // active / done / failed
  notes               String?
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([farmId, status])
  @@index([farmId, houseId, plantingDate])
  @@map("crop_cycles")
}

// 토양 관리 (친환경 인증 의무: 토양 검정 + 개량 + 윤작)
model soilManagement {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId       String   @map("farm_id")
  houseId      String?  @map("house_id")
  date         DateTime @db.Date
  type         String // test(검정) / amendment(개량) / rotation(윤작) / cover(피복)
  result       Json     @default("{}") // 검정 결과: {ph, ec, om, n, p, k, ca, mg}
  amendments   Json     @default("[]") // 개량 자재: [{name, qty, unit}]
  rotationCrop String?  @map("rotation_crop") // 윤작 작목
  notes        String?
  receiptPhoto String?  @map("receipt_photo") // 검정증명서/영수증 사진
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([farmId, date])
  @@index([farmId, type])
  @@map("soil_management")
}

// 자재 입출고 대장 (친환경 인증 의무) — 구매/사용/폐기 추적
// 친환경 인증: "농약·비료·종자 등 자재의 구매·사용·보관 사항" 기록 의무
// currentStock 은 application 측에서 sum(IN) - sum(OUT) - sum(DISPOSAL) 로 자동 계산
model inputInventory {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId       String   @map("farm_id")
  date         DateTime @db.Date
  type         String // 비료 / 농약 / 종자 / 기타
  productName  String   @map("product_name")
  manufacturer String?
  action       String // IN(입고) / OUT(사용) / DISPOSAL(폐기)
  quantity     Float
  unit         String
  supplier     String? // 공급처/판매처
  cost         Float? // IN 일 때만 의미
  receiptPhoto String?  @map("receipt_photo") // 영수증 사진 path
  notes        String?
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([farmId, date])
  @@index([farmId, productName])
  @@map("input_inventory")
}

model inputRecord {
  id               String    @id
  farmId           String    @map("farm_id")
  houseId          String?   @map("house_id")
  date             DateTime  @db.Date
  inputType        String    @map("input_type")
  // 작목 매핑 (PLS 작목별 사용횟수 제한 추적용)
  cropName         String?   @map("crop_name")
  cropCycleId      String?   @map("crop_cycle_id")
  productName      String    @map("product_name")
  manufacturer     String?
  quantity         Float
  unit             String
  cost             Float?
  targetArea       Float?    @map("target_area")
  method           String?
  notes            String?
  tags             String[]  @default([]) // 분류·검색용 태그
  // PLS / GAP 농약 정밀 기록 (인증/규제 의무) — inputType="농약" 일 때만 의미
  pesticideRegNo   String?   @map("pesticide_reg_no") // 농약 등록번호 (PSIS 시스템 검색용)
  dilutionRatio    String?   @map("dilution_ratio") // "1000배" 같은 희석 배수
  applicationCount Int?      @map("application_count") // 사용 횟수 (PLS: 작물별 제한 횟수 추적)
  safeUseInterval  Int?      @map("safe_use_interval") // 수확 전 사용 가능 일수 (n일 전까지 사용 가능)
  preHarvestDate   DateTime? @map("pre_harvest_date") @db.Date // = date + safeUseInterval (자동 계산)
  applicator       String? // 살포자 (재진입 안전관리)
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([farmId, date])
  @@map("input_records")
}

model maintenanceLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId      String   @map("farm_id")
  date        DateTime @db.Date
  type        String
  title       String
  description String?
  cost        Int?
  technician  String?
  status      String   @default("completed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  farm        farm     @relation(fields: [farmId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([farmId, date], map: "idx_maintenance_logs_farm_date")
  @@map("maintenance_logs")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model sensorData {
  timestamp DateTime @db.Timestamptz(6)
  farmId    String   @map("farm_id")
  houseId   String   @map("house_id")
  data      Json     @default("{}")
  metadata  Json?    @default("{}")

  @@id([timestamp, farmId, houseId])
  @@index([farmId, houseId, timestamp(sort: Desc)], map: "idx_sensor_data_farm_house")
  @@index([timestamp(sort: Desc)])
  @@map("sensor_data")
}

model camera {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId    String   @map("farm_id")
  camId     String   @map("cam_id")
  name      String
  location  String   @default("")
  rtspUrl   String   @map("rtsp_url")
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([farmId, camId])
  @@index([farmId])
  @@map("cameras")
}

model systemSetting {
  farmId    String   @id @map("farm_id")
  settings  Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model userFarm {
  id          String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String  @map("user_id")
  farmId      String  @map("farm_id")
  role        String? @default("viewer")
  permissions Json    @default("{}")
  farm        farm    @relation(fields: [farmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        user    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, farmId])
  @@map("user_farms")
}

model user {
  id            String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  username      String     @unique
  password      String
  name          String
  role          String     @default("worker")
  farmId        String     @default("farm_0001") @map("farm_id")
  allowedHouses String[]   @default([]) @map("allowed_houses")
  enabled       Boolean    @default(true)
  lastLoginAt   DateTime?  @map("last_login_at")
  refreshToken  String?    @map("refresh_token")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  userFarms     userFarm[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// 양액 관리 (Nutrient Management) — Phase 2
// ─────────────────────────────────────────────────────────────────

// 시나리오 (생장기/개화기 등) — UI 카드 1장 = 1 row
// dosingRatio, scheduleSlots, valves 같은 가변 길이 데이터는 JSONB 보관
model nutrientScenario {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId         String   @map("farm_id")
  name           String
  active         Boolean  @default(false) // 현재 적용 중 (농장당 1개만 true 권장)
  enabled        Boolean  @default(true) // 사용 가능 여부 (스위치)
  ecTarget       Float    @default(2.0) @map("ec_target") // mS/cm
  phTarget       Float    @default(6.0) @map("ph_target")
  dosingRatio    Json     @default("{}") @map("dosing_ratio") // {A:25, B:25, C:20, D:20, acid:5, F:5}
  irrigationMode String   @default("timer") @map("irrigation_mode") // 'solar' | 'timer' | 'schedule'
  solarThreshold Float?   @map("solar_threshold") // W/m² 누적 목표
  timerInterval  String?  @map("timer_interval") // "HH:MM"
  timerStart     String?  @map("timer_start") // "HH:MM"
  timerEnd       String?  @map("timer_end") // "HH:MM"
  scheduleSlots  Json     @default("[]") @map("schedule_slots") // ["08:00","09:30",...]
  days           Int[]    @default([]) // 요일 (0=일, 6=토)
  valves         Json     @default("[]") // [{duration:600, volume:150}, ...]
  sortOrder      Int      @default(0) @map("sort_order")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([farmId, active])
  @@index([farmId, sortOrder])
  @@map("nutrient_scenarios")
}

// 도싱 탱크 / 관수 밸브 / 하드웨어 설정 / 경보 한계 — 농장 1개당 1 row (JSONB)
// 양액 시스템 자체가 농장 단위라 별 row 분리하지 않고 단일 row 로 관리
model nutrientConfig {
  farmId       String   @id @map("farm_id")
  tanks        Json     @default("[]") // [{id, label, level, capacity, modbusReg}, ...]
  valveCount   Int      @default(0) @map("valve_count")
  valveGroups  Json     @default("[]") @map("valve_groups") // [{id, name, supplyLevel, color}, ...]
  valves       Json     @default("[]") // [{idx, groupId, crop, plantCount}, ...] — 구역별 상세
  alerts       Json     @default("{}") // {ecUpper, ecLower, ecCritical, phUpper, phLower, phCritical}
  hardware     Json     @default("{}") // {modbusUnit, ecSensorAddr, phSensorAddr, flowSensorAddr, pumpResponse, dosingPulseUnit}
  autoSchedule Json     @default("{\"items\":[],\"loop\":true}") @map("auto_schedule") // {items:[{scenarioId, repeat, enabled}], loop}
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("nutrient_configs")
}

// 경보 이력 — append-only, 시간순 조회
model nutrientAlert {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId     String    @map("farm_id")
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  alertType  String    @map("alert_type") // 'ec_upper' | 'ec_lower' | 'ph_upper' | 'tank_low' | 'sensor_error' | 'flow_anomaly' | ...
  severity   String    @default("warning") // 'warning' | 'critical' | 'info'
  value      Float?
  threshold  Float?
  message    String
  action     String? // 자동/수동 조치 내용
  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by")

  @@index([farmId, occurredAt(sort: Desc)])
  @@index([farmId, resolved, occurredAt(sort: Desc)])
  @@map("nutrient_alerts")
}

// 센서 보정 이력 — EC 1-pt, pH 3-pt
model nutrientCalibration {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId        String   @map("farm_id")
  sensorType    String   @map("sensor_type") // 'ec' | 'ph'
  calibratedAt  DateTime @default(now()) @map("calibrated_at") @db.Timestamptz(6)
  standardValue Float?   @map("standard_value") // EC: 1.413
  measuredValue Float?   @map("measured_value")
  offset        Float? // 측정-표준
  slope         Float? // pH: % 슬로프
  points        Json     @default("[]") // pH 3-pt: [{buffer, measured, offset}, ...]
  performedBy   String?  @map("performed_by")

  @@index([farmId, sensorType, calibratedAt(sort: Desc)])
  @@map("nutrient_calibrations")
}

// 누적 카운터 — 농장 1개당 1 row
// 도싱·관수 누적값은 RPi 가 주기적으로 누적 update, 초기화 시 lastReset 갱신
model nutrientCounter {
  farmId           String    @id @map("farm_id")
  totalDoseL       Float     @default(0) @map("total_dose_l")
  totalIrrigationL Float     @default(0) @map("total_irrigation_l")
  totalCycles      Int       @default(0) @map("total_cycles")
  pumpRuntimeMin   Int       @default(0) @map("pump_runtime_min")
  filterChangeAt   DateTime? @map("filter_change_at") @db.Date
  lastResetAt      DateTime? @map("last_reset_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at")

  @@map("nutrient_counters")
}

// 운영 상태 (mode + 현재 1회 사이클 정보) — 농장 1개당 1 row
// RPi 가 polling 으로 갱신, 웹은 short-poll 또는 SSE 로 구독
model nutrientState {
  farmId           String   @id @map("farm_id")
  mode             String   @default("paused") // 'auto' | 'manual' | 'paused' | 'emergency'
  activeScenarioId String?  @map("active_scenario_id")
  currentCycle     Json     @default("{}") @map("current_cycle") // {startedAt, expectedEndAt, suppliedL, ecAvg, phAvg, valveIdx}
  autoQueue        Json     @default("{}") @map("auto_queue") // {itemIdx, repeatDone, startedAt} — autoSchedule 진행 상태
  ecCurrent        Float?   @map("ec_current")
  phCurrent        Float?   @map("ph_current")
  solarAccumulated Float    @default(0) @map("solar_accumulated")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("nutrient_states")
}

// 수동 1회 공급 작업 — manual mode 의 ad-hoc 큐
// 즉시 실행 (scheduleAt null) 또는 24시간 이내 예약
model nutrientManualJob {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  farmId       String    @map("farm_id")
  scenarioId   String?   @map("scenario_id")
  scenarioName String?   @map("scenario_name")
  programNum   Int?      @map("program_num")
  valves       Json      @default("[]") // number[] — 밸브 id 배열
  volumeML     Int?      @map("volume_ml") // null 이면 시나리오 default 사용
  scheduleAt   DateTime? @map("schedule_at") @db.Timestamptz(6) // null = 즉시
  status       String    @default("pending") // pending | running | completed | aborted | cancelled
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([farmId, status])
  @@index([farmId, scheduleAt])
  @@map("nutrient_manual_jobs")
}
